<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Android 11+ (API 30) package visibility: without this block
      `getLocationApps` always resolves to an empty list.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
    </queries>

</manifest>
